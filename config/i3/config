set $mod Mod4
set $terminal kitty
set $launcher $HOME/.local/bin/kdc-dmenu
set $scripts $HOME/.local/bin
set $theme_file $HOME/.config/kali-desktop-core/theme.conf

font pango:monospace 10
floating_modifier $mod

exec_always --no-startup-id sh -c 'wallpaper="$HOME/.config/kali-desktop-core/current-wallpaper"; if [ -s "$wallpaper" ] && [ -f "$(cat "$wallpaper")" ]; then feh --no-fehbg --bg-fill "$(cat "$wallpaper")"; else xsetroot -solid "#0d0f12"; fi'
exec_always --no-startup-id sh -c '$HOME/.local/bin/kdc-bar >> "$HOME/.cache/kdc-bar.log" 2>&1'
exec_always --no-startup-id xsetroot -cursor_name left_ptr

focus_follows_mouse no
mouse_warping none
workspace_auto_back_and_forth yes
new_window pixel 2
new_float pixel 2
hide_edge_borders smart

# Las terminales deben abrirse en el workspace actual.
bindsym $mod+Return exec $terminal
bindsym $mod+d exec $launcher
bindsym $mod+Shift+r restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+q kill
# Menú de sesión/power integrado con dmenu.
bindsym $mod+Shift+e exec --no-startup-id $HOME/.local/bin/kdc-power-menu
bindsym $mod+Ctrl+l exec i3lock -c 0d0f12

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+v split v
bindsym $mod+b split h
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+space floating toggle

bindsym $mod+r mode resize
mode resize {
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym j resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt
  bindsym Return mode default
  bindsym Escape mode default
  bindsym $mod+r mode default
}

set $ws1 "1:term"
set $ws2 "2:web"
set $ws3 "3:ops"
set $ws4 "4:notes"
set $ws5 "5:misc"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5

for_window [class=".*"] border pixel 2
gaps inner 6
gaps outer 4
# gaps top debe ser ligeramente mayor que BAR_HEIGHT para dejar espacio a lemonbar.
gaps top 28

client.focused          #2f3440 #2f3440 #d0d0d0 #8fb7ff #2f3440
client.focused_inactive #1a1d24 #1a1d24 #9ba3af #5c6370 #1a1d24
